+    def test_resolution_invariance(self):
+        a = run(crossing(60, FPS, speed_h_per_s=3.0, dy_h=0.1, merge_iou=0.3))
+        b = run(crossing(60, FPS, speed_h_per_s=3.0, dy_h=0.1, merge_iou=0.3, scale=2.0), width=2 * W,
