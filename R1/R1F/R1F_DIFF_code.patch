+                frames = [SceneFrame({"TARGET": b}) for b in linear(40, (1150, 400), (8, 0))]
+                frames += [SceneFrame({"PERSON_A": b}) for b in linear(120, (1250, 400), (-4, 0))]
+                r = run(frames, ppl)
+                for ev in r.tracker.reacquisition_events:
+                    if ev.evidence["best_competitor"] is None:
