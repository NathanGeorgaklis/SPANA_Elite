+        b = S.dumps_canonical(SD.build_doc(self.cfg))
+        self.assertEqual(a, b)
+        self.assertTrue(a.endswith("\n"))
+        bad = SD.build_doc(self.cfg)
+        bad["summary"]["processing_time_s"] = float("nan")
