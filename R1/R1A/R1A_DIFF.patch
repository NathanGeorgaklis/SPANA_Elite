+
+    def test_population_record_rules(self):
+        def m(doc):
+            doc["frame_log"][0]["tracks"][1]["state"] = "PROVISIONAL"
+        self.assertIn("population triple", self._errs(m))
+
+    def test_provenance_rules(self):
+        def m(doc):
+            doc["summary"]["v2"]["provenance"]["decode_mode"] = "RESUMED"
