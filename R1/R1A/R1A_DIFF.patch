+        self.assertEqual(S.legacy_state_for("PROVISIONAL"), "LOST")  # unknown key -> event_adapter default
+        self.assertEqual(S.LEGACY_STATE_EVIDENCE["OUT_OF_FRAME"][1], "INFERRED")
