+        for bad in (np.zeros((0, 10, 3), np.uint8), np.zeros((10, 0, 3), np.uint8), np.zeros((10, 10), np.uint8),
+                    np.zeros((10, 10, 3), np.float32), np.zeros((10, 10, 4), np.uint8), None):
+            with self.subTest(bad=None if bad is None else bad.shape):
