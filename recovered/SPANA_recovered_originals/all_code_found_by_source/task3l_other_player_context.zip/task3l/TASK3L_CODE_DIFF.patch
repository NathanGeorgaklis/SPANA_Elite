     track_id: Optional[str] = None
 
 
+# TASK 3L: target-body FRAGMENT exclusion. On GOLD_DUEL_01 a person box of
+# 12-14% of the target's area, lying entirely inside the target's box (his own
+# leg), passed the IoU<0.5 duplicate test, was read as a same-kit TEAMMATE and
+# became the confirmed receiver of a pass that never happened. IoU cannot see
+# this case (a small box inside a big one always has small IoU). A box is a
+# SUBORDINATE detection of the target when all three hold:
+#   - it lies (almost) wholly inside the target box,
+#   - it is much smaller than the target box, and
+#   - it does not span the target's height (a limb / torso / leg crop).
+# An independent person overlapping the target during a challenge -- even one
+# largely hidden behind him -- still spans most of the target's height at the
+# same depth, or sticks out of his box, and is therefore retained. Naive
+# "anything overlapping the target" suppression is deliberately NOT used: it
+# would delete the real defender in a duel.
+TASK3L_FRAGMENT_EXCLUSION = True       # False reproduces pre-Task-3L behaviour exactly (diagnostic replays)
+FRAGMENT_MIN_CONTAINMENT = 0.85        # fraction of the candidate's own area inside the target box
+FRAGMENT_MAX_AREA_RATIO = 0.5          # candidate area / target area
+FRAGMENT_MAX_HEIGHT_RATIO = 0.8        # candidate height / target height
+
+
+def _area(b):
+    return max(0.0, b[2] - b[0]) * max(0.0, b[3] - b[1])
+
+
+def is_target_fragment(box, tracked_bbox):
+    ta, ba = _area(tracked_bbox), _area(box)
+    if ta <= 0 or ba <= 0:
+        return False
+    ix = max(0.0, min(box[2], tracked_bbox[2]) - max(box[0], tracked_bbox[0]))
+    iy = max(0.0, min(box[3], tracked_bbox[3]) - max(box[1], tracked_bbox[1]))
+    containment = ix * iy / ba
+    height_ratio = (box[3] - box[1]) / max(1e-9, tracked_bbox[3] - tracked_bbox[1])
+    return (containment >= FRAGMENT_MIN_CONTAINMENT and ba / ta <= FRAGMENT_MAX_AREA_RATIO
+            and height_ratio <= FRAGMENT_MAX_HEIGHT_RATIO)
+
+
 def classify_vs_target(box, tracked_bbox):
     """rule #7. Returns (classification, separate_from_target_confidence).
     Never mutates or reads anything beyond the plain box tuples -- the
     tracked-player box itself is never touched."""
     i = iou(box, tracked_bbox)
-    classification = "TARGET_PLAYER_DUPLICATE" if i >= TARGET_DUPLICATE_IOU else "PERSON_DETECTED"
+    if i >= TARGET_DUPLICATE_IOU:
+        classification = "TARGET_PLAYER_DUPLICATE"
+    elif TASK3L_FRAGMENT_EXCLUSION and is_target_fragment(box, tracked_bbox):
+        classification = "TARGET_PLAYER_FRAGMENT"
+    else:
+        classification = "PERSON_DETECTED"
     return classification, max(0.0, 1.0 - i)
 
 
